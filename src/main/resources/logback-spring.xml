<?xml version="1.0" encoding="UTF-8"?>
<configuration>
  <conversionRule conversionWord="identitySafe" class="com.example.demodatn.config.IdentityLogMask"/>
  <include resource="org/springframework/boot/logging/logback/defaults.xml"/>
  <property name="CONSOLE_LOG_PATTERN" value="%d{yyyy-MM-dd HH:mm:ss.SSS} %5p %logger{40} : %identitySafe(%msg%n%ex)"/>
  <property name="FILE_LOG_PATTERN" value="${CONSOLE_LOG_PATTERN}"/>
  <include resource="org/springframework/boot/logging/logback/console-appender.xml"/>
  <root level="INFO"><appender-ref ref="CONSOLE"/></root>
</configuration>
