# Mau cau hinh may phat trien (copy thanh application-local.properties)
# File application-local.properties da duoc them vao .gitignore, khong bi commit.
#
# Cac thuoc tinh o day se ghi de gia tri mac dinh trong application.properties.
# Neu su dung bien moi truong, bien moi truong van co do uu tien cao hon.

spring.datasource.url=jdbc:sqlserver://localhost:1433;databaseName=shopbangiay;encrypt=true;trustServerCertificate=true
spring.datasource.username=sa
spring.datasource.password=123456789
spring.jpa.hibernate.ddl-auto=validate

