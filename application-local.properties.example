# ==============================================================================
# VÍ DỤ CẤU HÌNH CỤC BỘ DÀNH CHO NHÀ PHÁT TRIỂN (DEVELOPMENT ENVIRONMENT)
# Sao chép nội dung file này thành `application-local.properties` cùng thư mục chạy app.
# File `application-local.properties` đã được .gitignore, KHÔNG ĐƯỢC COMMIT bí mật lên git.
# ==============================================================================

# 1. Cấu hình Database kiểm thử (SQL Server)
spring.datasource.url=jdbc:sqlserver://localhost:1433;databaseName=shopbangiay_kt_20261103_gd20;encrypt=true;trustServerCertificate=true
spring.datasource.username=sa
spring.datasource.password=123456789
spring.jpa.hibernate.ddl-auto=validate

